<!DOCTYPE html>
<html>
  <head>
    <title>Urban Admin</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/auto_favi.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/css/admin.css" />
    <script
      src="https://kit.fontawesome.com/f7b393d83e.js"
      crossorigin="anonymous"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css"
      integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2"
      crossorigin="anonymous"
    />
  </head>
<body class="py-4">

<div class="container mt-2">
        
<div class="bg-dark text-white py-3 px-4">
  <div class="d-flex justify-content-between align-items-center">
    <h3 class="mb-0">Add New Car</h3>
    <div>
      <a class="btn btn-light mr-2" href="/admin/admin_index">Back to dashboard</a>
      <a class="btn btn-light" href="/admin/home">Back to Home</a>
    </div>
  </div>
</div>



    {{#if errorMessageArray}}
      <div class="alert alert-danger">
        <ul>
          {{#each errorMessageArray}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}
    <form action="addgas" method="POST" enctype="multipart/form-data" autocomplete="off">

      <div class="card mb-4">
        <div class="card-header font-weight-bold">Media Uploads</div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Main Image (Visible on List Page)</label>
              <input type="file" class="form-control" name="imagePath" required />
            </div>
            <div class="form-group col-md-4">
              <label>Gallery Images (Up to 4)</label>
              <input type="file" class="form-control" name="galleryImages" multiple accept="image/*" />
            </div>
            <div class="form-group col-md-4">
              <label>Video (Optional)</label>
              <input type="file" class="form-control" name="video" accept="video/*" />
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header font-weight-bold">Basic Info</div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Title</label>
              <input type="text" class="form-control" name="title" placeholder="Honda FIT" value="{{formData.title}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Version/Grade</label>
              <input type="text" class="form-control" name="t2" placeholder="G Grade" value="{{formData.t2}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Year</label>
              <select class="form-control" name="year">
                {{#each years}}
                  <option value="{{this}}" {{#ifEquals this ../formData.year}}selected{{/ifEquals}}>{{this}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Price (optional)</label>
              <input type="text" class="form-control" name="priceStr" placeholder="10000000" value="{{formData.priceStr}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Top Speed</label>
              <input type="text" class="form-control" name="topspeed" placeholder="185" value="{{formData.topspeed}}" />
            </div>
            <div class="form-group col-md-4">
              <label>0-60 Time</label>
              <input type="text" class="form-control" name="time60" placeholder="3.5" value="{{formData.time60}}" />
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header font-weight-bold">Specifications</div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group col-md-3">
              <label>Mileage</label>
              <input type="text" class="form-control" name="mileage" placeholder="1900" value="{{formData.mileage}}" />
            </div>
            <div class="form-group col-md-3">
              <label>Engine</label>
              <input type="number" step="0.1" class="form-control" name="engine" placeholder="5.0" value="{{formData.engine}}" />
            </div>
            <div class="form-group col-md-3">
              <label>Cylinders</label>
              <input type="number" class="form-control" name="cyl" placeholder="8" value="{{formData.cyl}}" />
            </div>
            <div class="form-group col-md-3">
              <label>Gearbox</label>
              <input type="text" class="form-control" name="gearbox" placeholder="6-Speed SelectShift" value="{{formData.gearbox}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Transmission</label>
              <input type="text" class="form-control" name="transmission" placeholder="Automatic" value="{{formData.transmission}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Colour</label>
              <input type="text" class="form-control" name="colour" placeholder="Twister Orange" value="{{formData.colour}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Interior</label>
              <input type="text" class="form-control" name="interior" placeholder="Leather Trimmed Interior" value="{{formData.interior}}" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-4">
              <label>Body</label>
              <input type="text" class="form-control" name="body" placeholder="2 Door Coupe" value="{{formData.body}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Drivetrain</label>
              <input type="text" class="form-control" name="drivetrain" placeholder="RWD" value="{{formData.drivetrain}}" />
            </div>
            <div class="form-group col-md-4">
              <label>Wheel</label>
              <input type="text" class="form-control" name="wheel" placeholder="18'' Aluminium Wheels" value="{{formData.wheel}}" />
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header font-weight-bold">Details</div>
        <div class="card-body">
          <div class="form-group">
            <label>Description</label>
            <textarea class="form-control" name="description" rows="3" placeholder="Description Info">{{formData.description}}</textarea>
          </div>
          <div class="form-group">
            <label>Safety</label>
            <textarea class="form-control" name="safety" rows="3" placeholder="Safety Info">{{formData.safety}}</textarea>
          </div>
          <div class="form-group">
            <label>Technology</label>
            <textarea class="form-control" name="technology" rows="3" placeholder="Tech Info">{{formData.technology}}</textarea>
          </div>
        </div>
      </div>

      <div class="form-group text-right">
        <button type="submit" class="btn btn-block bg-dark text-white">Save</button>
        <a class="btn btn-secondary btn-block" href="gas">Back</a>
      </div>
</div>
    </form>
  </body>
</html>