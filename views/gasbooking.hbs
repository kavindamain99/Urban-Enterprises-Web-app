<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URBAN</title>

    {{!-- Google Fonts --}}
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=PT+Sans+Caption&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand&display=swap" rel="stylesheet">

    {{!-- Stylesheets --}}
    <link rel="stylesheet" href="/css/booking.css">
</head>



<body>




    <!-- Booking -->

    <section id="booking">

        <div class="container">


            <div class="row">

                <!-- Column 1 -->
                <div class="col-sm">

                    <div class="heading">
                        <h2>{{model.title}}</h2>
                        <h3>{{model.t2}}</h3>
                    </div>


                    <div class="carousal-container" style="margin-bottom: 200px;">
                        <div id="carouselExampleInterval" class="carousel slide" data-ride="carousel">
                            <div class="carousel-inner">
                                <!-- 🟢 MAIN IMAGE DISPLAY -->
                                <div class="text-center">
                                    <!-- 🖼️ Image with 5:4 aspect ratio -->
                                    <div
                                        style="width: 500px; height: 400px; overflow: hidden; margin: 0 auto; border-radius: 8px;">
                                        <img id="main-display" src="{{model.imagePath}}"
                                            style="width: 100%; height: 100%; object-fit: cover;" class="rounded" />
                                    </div>

                                    <!-- 🎥 Video with 5:4 aspect ratio -->
                                    <div style="width: 500px; height: 400px; overflow: hidden; margin: 0 auto; border-radius: 8px; display: none;"
                                        id="main-video-container">
                                        <video id="main-video" controls
                                            style="width: 100%; height: 100%; object-fit: cover;" class="rounded">
                                            <source src="{{model.video}}" type="video/mp4" />
                                        </video>
                                    </div>
                                </div>


                                <div class="d-flex justify-content-center mt-3">
                                    {{#each model.galleryImages}}
                                    <img src="{{this}}" class="thumb-img mx-2"
                                        style="width: 100px; height: 80px; object-fit: contain; border: 2px solid #ddd; cursor: pointer; border-radius: 4px;"
                                        onclick="switchToImage('{{this}}')">
                                    {{/each}}

                                    {{#if model.video}}
                                    <video class="mx-2"
                                        style="width: 100px; height: 80px; object-fit: cover; border: 2px solid #ddd; border-radius: 4px; cursor: pointer;"
                                        onclick="switchToVideo()">
                                        <source src="{{model.video}}" type="video/mp4" />
                                    </video>
                                    {{/if}}
                                </div>


                                <div class="carousel-item" data-interval="2000">
                                    <img style="padding-bottom: 20px;" src="/images/1int.JPG" class="d-block w-100"
                                        alt="...">
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="py-5"></div>

                    <!-- Main Specs -->
                    <div class="row specs-row">

                        <div class="col specs-box">
                            <svg style="width:24px;height:24px;color:#626468">
                                <path fill="currentColor"
                                    d="M18,10A1,1 0 0,1 17,9A1,1 0 0,1 18,8A1,1 0 0,1 19,9A1,1 0 0,1 18,10M12,10H6V5H12M19.77,7.23L19.78,7.22L16.06,3.5L15,4.56L17.11,6.67C16.17,7 15.5,7.93 15.5,9A2.5,2.5 0 0,0 18,11.5C18.36,11.5 18.69,11.42 19,11.29V18.5A1,1 0 0,1 18,19.5A1,1 0 0,1 17,18.5V14C17,12.89 16.1,12 15,12H14V5C14,3.89 13.1,3 12,3H6C4.89,3 4,3.89 4,5V21H14V13.5H15.5V18.5A2.5,2.5 0 0,0 18,21A2.5,2.5 0 0,0 20.5,18.5V9C20.5,8.31 20.22,7.68 19.77,7.23Z" />
                            </svg>
                            <p class="spec1">{{model.mileage}}<span class="spec2">mpg</span> </p>
                            <p class="spec3">Mileage</p>
                        </div>

                    </div>



