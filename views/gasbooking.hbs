                </div>





                <!-- Column 2 -->
                <div class="col-sm">


                    <!-- Pricing -->
                    <div class="container">
                        <div class="modelprice">LKR {{model.priceStr}}</div>
                        <div class="modelprice price-desc">Excluding taxes and order fee</div>
                    </div>

                    <div class="text-center placeorder-container">
                        <button type="button" data-toggle="modal" data-target="#contactModal"
                            class="btn btn-outline-dark placeorder"> Inquire Now
                        </button>
                    </div>


                    <!-- Description -->
                    <div class="container-fluid description">

                        {{!-- <div class="desc">
                            <h4 class="desc-heading">Warranty</h4>
                            <p class="desc-para">50,000 KM / 4 years</p>
                        </div> --}}

                        <div class="desc">
                            <h4 class="desc-heading">Performance</h4>
                            <p class="desc-para">{{model.description}}</p>
                        </div>
                        <div class="desc">
                            <h4 class="desc-heading">Safety</h4>
                            <p class="desc-para">{{model.safety}}</p>
                        </div>
                        <div class="desc">
                            <h4 class="desc-heading">Technology</h4>
                            <p class="desc-para">{{model.technology}}</p>
                        </div>


                    </div>


                </div>


            </div>


        </div>

    </section>


    {{!-- Contact Form --}}
    <div id="contactModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Get in Touch with our Agent</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label class="col-form-label">Name</label>
                            <input type="text" class="form-control" id="username" placeholder="name">
                        </div>

                        <div class="form-group">
                            <label>Email address</label>
                            <input type="email" class="form-control" id="useremail" placeholder="name@gmail.com">
                        </div>

                        <div class="form-group">
                            <label>Phone</label>
                            <input type="tel" class="form-control" id="userphone" placeholder="07xxxxxxxx"
                                pattern="[0-9]{10}" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" id="contactSubmit" class="btn btn-secondary">Submit</button>
                </div>
            </div>
        </div>
    </div>


    <script>
        function switchToVideo() {
            document.getElementById('main-display').style.display = 'none';
            document.getElementById('main-video').style.display = 'block';
            document.getElementById('main-video').load();
        }

        function switchToImage(imgSrc) {
            document.getElementById('main-video').style.display = 'none';
            document.getElementById('main-video').pause();
            document.getElementById('main-display').style.display = 'block';
            document.getElementById('main-display').src = imgSrc;
        }
    </script>


</body>

</html>